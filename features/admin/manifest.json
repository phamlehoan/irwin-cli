{
  "id": "admin",
  "version": "1.0.0",
  "description": "Admin area: dashboard + user management (login required, no RBAC yet)",
  "requires": ["auth"],
  "files": {
    "from": "files"
  },
  "patches": [
    {
      "file": "configs/routes/index.ts",
      "ops": [
        {
          "type": "insertAfter",
          "marker": "// @irwin:routes-imports",
          "content": "import { AdminRoute } from \"./admin\";\n"
        },
        {
          "type": "insertAfter",
          "marker": "// @irwin:after-current-user",
          "content": "    this.path(\"/admin\", AdminRoute.draw());\n"
        }
      ]
    },
    {
      "file": "app/controllers/application.controller.ts",
      "ops": [
        {
          "type": "insertBefore",
          "marker": "protected logActionCompletion()",
          "content": "  protected requireLogin(): boolean {\n    return this.authenticateUser();\n  }\n\n"
        }
      ]
    },
    {
      "file": "app/controllers/index.ts",
      "ops": [
        {
          "type": "append",
          "content": "export * from \"./admin\";\n"
        }
      ]
    }
  ],
  "postInstall": {
    "messages": [
      "Open: GET /admin (after login at /auth)",
      "Seed user: admin@example.com / password123",
      "RBAC (roles/features) is not included — add in a later pack or extend from irwin-framework"
    ]
  }
}
