{
  "id": "session",
  "version": "1.1.0",
  "description": "express-session + express-flash (password hasher now lives in the hash pack)",
  "requires": [
    "hash"
  ],
  "npm": {
    "dependencies": {
      "express-session": "^1.19.0",
      "express-flash": "^0.0.2"
    },
    "devDependencies": {
      "@types/express-session": "^1.18.2"
    }
  },
  "files": {
    "from": "files",
    "overwrite": [
      "typing-stubs/express/index.d.ts",
      "typing-stubs/express-flash.d.ts"
    ]
  },
  "patches": [
    {
      "file": "configs/application.ts",
      "ops": [
        {
          "type": "insertAfter",
          "marker": "import { initializeCache, initializeLogger } from \"./initializers\";",
          "content": "\nimport { initializeSession } from \"./initializers\";"
        },
        {
          "type": "insertAfter",
          "marker": "import express from \"express\";",
          "content": "\nimport flash from \"express-flash\";"
        },
        {
          "type": "insertAfter",
          "marker": "// @irwin:setup-app-middlewares",
          "content": "\n    const sessionMiddleware = initializeSession();\n    this.app.use((req, res, next) => {\n      const isStateless =\n        req.path.startsWith(\"/api\") || req.path.startsWith(\"/docs\");\n      if (isStateless) return next();\n      sessionMiddleware(req, res, (err) => {\n        if (err) return next(err);\n        flash()(req, res, next);\n      });\n    });"
        }
      ]
    },
    {
      "file": "configs/initializers/index.ts",
      "ops": [
        {
          "type": "append",
          "content": "export * from \"./session\";\n"
        }
      ]
    }
  ],
  "postInstall": {
    "messages": [
      "SESSION_SECRET is generated into .env on install"
    ],
    "generateSecrets": [
      "SESSION_SECRET"
    ]
  }
}
