{
  "id": "database",
  "version": "1.0.0",
  "description": "Prisma SQLite + User/Password models and seed",
  "requires": [],
  "npm": {
    "dependencies": {
      "@prisma/client": "^7.7.0",
      "prisma": "^7.7.0",
      "@prisma/adapter-better-sqlite3": "^7.7.0",
      "better-sqlite3": "^12.8.0",
      "bcrypt": "^5.1.1"
    },
    "devDependencies": {
      "@types/better-sqlite3": "^7.6.13",
      "@types/bcrypt": "^5.0.2",
      "tsx": "^4.21.0"
    },
    "scripts": {
      "db:generate": "prisma generate",
      "db:push": "prisma db push",
      "db:migrate": "prisma migrate dev",
      "db:seed": "tsx configs/db/seed.ts"
    }
  },
  "files": {
    "from": "files"
  },
  "patches": [
    {
      "file": ".env.example",
      "ops": [
        {
          "type": "append",
          "content": "DATABASE_URL=file:./database/app.db\n# Admin seeded by db:seed (no built-in credentials). SEED_ADMIN_PASSWORD is generated on install.\nSEED_ADMIN_EMAIL=\nSEED_ADMIN_PASSWORD=\n"
        }
      ]
    },
    {
      "file": "tsconfig.json",
      "ops": [
        {
          "type": "insertAfter",
          "marker": "// @irwin:tsconfig-paths",
          "content": "\n      \"@db\": [\"./app/models/generated/prisma/client\"],\n      \"@db/*\": [\"./app/models/generated/prisma/client/*\"],\n      \"@models\": [\"./app/models\"],\n      \"@models/*\": [\"./app/models/*\"],"
        }
      ]
    }
  ],
  "postInstall": {
    "install": true,
    "scripts": [
      "db:generate",
      "db:push"
    ],
    "messages": [
      "Set DATABASE_URL in .env (default file:./database/app.db)",
      "Login user: run pnpm db:seed after irwin add auth (auth re-seeds after schema is final)",
      "Optional now (API-only / no auth yet): pnpm db:seed"
    ],
    "generateSecrets": [
      "SEED_ADMIN_PASSWORD"
    ],
    "createEnvFile": true
  }
}
