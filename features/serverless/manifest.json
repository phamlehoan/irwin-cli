{
  "id": "serverless",
  "version": "1.0.0",
  "description": "AWS Serverless Framework + serverless-offline",
  "requires": ["database"],
  "npm": {
    "dependencies": {
      "serverless-http": "^3.2.0"
    },
    "devDependencies": {
      "serverless": "^4.33.3",
      "serverless-offline": "^14.5.0"
    }
  },
  "files": {
    "from": "files"
  },
  "patches": [
    {
      "file": "package.json",
      "ops": [
        {
          "type": "insertAfter",
          "marker": "\"start\": \"node dist/index.js\"",
          "content": ",\n    \"serverless\": \"serverless offline --noPrependStageInUrl\""
        }
      ]
    }
  ],
  "postInstall": {
    "messages": [
      "Build first: pnpm build",
      "Run: pnpm serverless (serverless-offline)",
      "Handler: dist/lambda.js — wire Turso via irwin add turso"
    ]
  }
}
